rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teste de conexão do sistema
    match /test/{docId} {
      allow read, write: if true;
    }

    // Pedidos (criação pelo cardápio digital, leitura pelo cliente e admin, atualização pelo Kanban/KDS)
    match /pedidos/{pedidoId} {
      allow read: if true;
      allow create: if request.resource.data.clienteNome is string
                    && request.resource.data.valorTotal is number;
      allow update, delete: if true;
    }

    // Produtos do Cardápio (leitura pública para clientes, gerenciamento pelo admin)
    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if true;
    }

    // Categorias do Cardápio
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if true;
    }

    // Entregadores / Motoboys
    match /entregadores/{entregadorId} {
      allow read: if true;
      allow write: if true;
    }

    // Transações Financeiras e Caixa
    match /transacoes_financeiras/{transacaoId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
